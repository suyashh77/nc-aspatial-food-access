# This repo holds the code only. Datasets, results, documents and the presentation live in the Google Drive folder
# (built by build_drive_package.py); place_data.sh copies them into a clone.
# Allowlist: nothing is tracked unless listed below. Licensed data (Advan, SafeGraph) is never committed.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/PIPELINE_GUIDE.md
!/run_after_labeling.sh
!/build_drive_package.py
!/place_data.sh
!/requirements_lab_vm.txt

# The guide for whoever picks up the code, and the scripts that build the presentation
!/handoff/
/handoff/*
!/handoff/FOR_CLAUDE.md
!/handoff/presentation/
/handoff/presentation/*
!/handoff/presentation/build_deck.py
!/handoff/presentation/make_maps.py
!/handoff/presentation/deck_style.css

# Pipeline A: scripts, decision tests, labeling page, tests. Of data/, only the hand-made draft topic list.
!/NC Pipeline/
/NC Pipeline/*
!/NC Pipeline/*.py
!/NC Pipeline/README.md
!/NC Pipeline/apps/
!/NC Pipeline/tests/
!/NC Pipeline/decisions/
/NC Pipeline/decisions/*
!/NC Pipeline/decisions/*.py
!/NC Pipeline/data/
/NC Pipeline/data/*
!/NC Pipeline/data/parents_draft.csv

# Pipeline B: scripts
!/NC Pipeline Improved/
/NC Pipeline Improved/*
!/NC Pipeline Improved/*.py

**/__pycache__/
**/.pytest_cache/
