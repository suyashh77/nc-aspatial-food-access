{"text": "<style>\n.nt { display: flex; flex-direction: column; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n.nt-head { display: flex; flex-direction: column; gap: var(--cds-gap-xs); }\n.nt-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; }\n.nt-take { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-body); max-width: 70ch; }\n.nt-take span { color: var(--color-fg); font-variant-numeric: tabular-nums; }\n.nt-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr)); gap: var(--cds-gap-md); }\n.nt-kpi { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n.nt-kpi .lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.nt-kpi .val { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.1; font-variant-numeric: tabular-nums; }\n.nt-kpi .sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.nt-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: var(--cds-gap-md); }\n.nt-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n.nt-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.nt-note { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.nt-map { position: relative; min-height: 22rem; cursor: crosshair; }\n.nt-map canvas { display: block; width: 100%; }\n.nt-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); align-items: center; }\n.nt-legend i { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 50%; margin-right: 0.35rem; vertical-align: -1px; }\n.nt-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); max-width: 16rem; z-index: 2; }\n.nt-tip .k { color: var(--cds-text-secondary); }\n.nt-detail-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); line-height: 1.15; margin: 0; overflow-wrap: anywhere; }\n.nt-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: var(--cds-gap-sm); }\n.nt-facts div { display: flex; flex-direction: column; gap: 2px; border-top: 1px solid var(--color-border-line); padding-top: var(--cds-pad-xs); }\n.nt-facts .lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.nt-facts .v { font-size: var(--cds-font-size-heading); font-variant-numeric: tabular-nums; }\n.nt-words { display: grid; grid-template-columns: auto 1fr; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-body); align-items: baseline; }\n.nt-words .lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); white-space: nowrap; }\n.nt-words span:not(.lab) { overflow-wrap: anywhere; }\n.nt-stars { display: flex; height: 0.9rem; gap: 2px; border-radius: 4px; overflow: hidden; }\n.nt-stars i { display: block; height: 100%; }\n.nt-starkey { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.nt-starkey i { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 2px; margin-right: 0.3rem; vertical-align: -1px; }\n.nt-toolbar { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); align-items: center; justify-content: space-between; }\n.nt-seg { display: inline-flex; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: hidden; }\n.nt-seg button { border: 0; background: transparent; color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); font: inherit; font-size: var(--cds-font-size-caption); cursor: pointer; }\n.nt-seg button[aria-pressed=\"true\"] { background: var(--color-bg); color: var(--color-fg); }\n.nt-reviews { display: flex; flex-direction: column; gap: var(--cds-gap-sm); max-height: 34rem; overflow: auto; min-height: 8rem; }\n.nt-rev { border-top: 1px solid var(--color-border-line); padding-top: var(--cds-pad-sm); display: flex; flex-direction: column; gap: 2px; }\n.nt-rev .meta { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); }\n.nt-rev .st { color: var(--color-fg); letter-spacing: 1px; }\n.nt-rev p { margin: 0; font-size: var(--cds-font-size-body); line-height: 1.45; max-width: 75ch; overflow-wrap: anywhere; }\n.nt-search { font: inherit; font-size: var(--cds-font-size-body); color: var(--color-fg); background: var(--color-bg); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm); min-width: 0; width: min(100%, 18rem); }\n.nt-tablebox { max-height: 30rem; overflow: auto; }\n.nt-table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-body); font-variant-numeric: tabular-nums; }\n.nt-table th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.nt-table th button { all: unset; cursor: pointer; }\n.nt-table th button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n.nt-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: middle; }\n.nt-table td.num, .nt-table th.num { text-align: right; }\n.nt-table[data-source=\"topics\"] tbody tr { cursor: pointer; }\n.nt-grid tbody tr.on td { font-weight: var(--cds-font-weight-medium); }\n.nt-table tbody tr:hover { background: var(--color-bg); }\n.nt-table tbody tr.on { background: var(--color-bg); box-shadow: inset 3px 0 0 var(--nt-accent, var(--color-fg)); }\n.nt-bar { display: flex; align-items: center; gap: var(--cds-gap-sm); justify-content: flex-end; }\n.nt-bar i { display: block; height: 0.55rem; border-radius: 4px; min-width: 2px; }\n.nt-label { max-width: 22rem; overflow-wrap: anywhere; }\n.nt-chip { font-size: var(--cds-font-size-caption); border: 1px solid var(--color-border-line); border-radius: 999px; padding: 0 var(--cds-pad-sm); color: var(--color-fg-muted); }\n.nt-method { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: var(--cds-gap-xs); font-size: var(--cds-font-size-body); max-width: 75ch; }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.nt-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); min-height: inherit; }\n.nt-fail::before { content: \"\"; width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-bad); }\n</style>\n\n<div class=\"nt\">\n  <header class=\"nt-head\" id=\"overview\">\n    <h1>NC review topics</h1>\n    <p class=\"nt-take\">\n      <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"reviews_clustered\" data-row=\"0\"></span> Google reviews from\n      <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"stores\" data-row=\"0\"></span> North Carolina grocery stores, clustered without labels into\n      <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"topics\" data-row=\"0\"></span> topics.\n      <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"outlier_share\" data-row=\"0\"></span> of reviews fit no topic. Click a topic on the map or in the table to read its reviews.\n    </p>\n  </header>\n\n  <section class=\"nt-kpis\" id=\"kpis\">\n    <div class=\"nt-kpi\"><span class=\"lab\">Reviews clustered</span><span class=\"val dash-skeleton\" data-source=\"summary\" data-field=\"reviews_clustered\" data-row=\"0\"></span><span class=\"sub\">of <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"reviews_with_text\" data-row=\"0\"></span> with text</span></div>\n    <div class=\"nt-kpi\"><span class=\"lab\">Stores</span><span class=\"val dash-skeleton\" data-source=\"summary\" data-field=\"stores\" data-row=\"0\"></span><span class=\"sub\">with at least one text review</span></div>\n    <div class=\"nt-kpi\"><span class=\"lab\">Topics</span><span class=\"val dash-skeleton\" data-source=\"summary\" data-field=\"topics\" data-row=\"0\"></span><span class=\"sub\">Raleigh pilot: <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"teresa_topics\" data-row=\"0\"></span></span></div>\n    <div class=\"nt-kpi\"><span class=\"lab\">Fit no topic</span><span class=\"val dash-skeleton\" data-source=\"summary\" data-field=\"outlier_share\" data-row=\"0\"></span><span class=\"sub\">HDBSCAN outliers</span></div>\n    <div class=\"nt-kpi\"><span class=\"lab\">Coherence (C<sub>v</sub>)</span><span class=\"val dash-skeleton\" data-source=\"summary\" data-field=\"coherence_cv\" data-row=\"0\"></span><span class=\"sub\">Raleigh pilot: <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"teresa_coherence\" data-row=\"0\"></span></span></div>\n    <div class=\"nt-kpi\"><span class=\"lab\">Topic diversity</span><span class=\"val dash-skeleton\" data-source=\"summary\" data-field=\"topic_diversity\" data-row=\"0\"></span><span class=\"sub\">Raleigh pilot: <span class=\"dash-skeleton\" data-source=\"summary\" data-field=\"teresa_diversity\" data-row=\"0\"></span></span></div>\n  </section>\n\n  <div class=\"nt-row\">\n    <section class=\"nt-card\" id=\"map\">\n      <h2>Review map</h2>\n      <p class=\"nt-note\">Each dot is a review, placed by meaning (2-D UMAP of its embedding), from a sample of every topic and of the outliers. Hover to see a dot's topic, click to select it.</p>\n      <div class=\"nt-map\" data-source=\"map_points topics\"><canvas aria-label=\"Map of reviews colored by topic\"></canvas><div class=\"nt-tip\" hidden></div></div>\n      <div class=\"nt-legend\"><span><i class=\"lg-sel\"></i>selected topic</span><span><i class=\"lg-oth\"></i>other topics</span><span><i class=\"lg-out\"></i>no topic</span></div>\n    </section>\n\n    <section class=\"nt-card\" id=\"topic\">\n      <h2>Selected topic</h2>\n      <p class=\"nt-detail-title\" data-source=\"topics\" data-field=\"label\"></p>\n      <div class=\"nt-facts\">\n        <div><span class=\"lab\">Topic</span><span class=\"v\" data-source=\"topics\" data-field=\"topic\"></span></div>\n        <div><span class=\"lab\">Reviews</span><span class=\"v\" data-source=\"topics\" data-field=\"reviews\"></span></div>\n        <div><span class=\"lab\">Share of all</span><span class=\"v\" data-source=\"topics\" data-field=\"share\"></span></div>\n        <div><span class=\"lab\">Avg stars</span><span class=\"v\" data-source=\"topics\" data-field=\"avg_stars\"></span></div>\n        <div><span class=\"lab\">Stores</span><span class=\"v\" data-source=\"topics\" data-field=\"stores\"></span></div>\n        <div><span class=\"lab\">Avg membership</span><span class=\"v\" data-source=\"topics\" data-field=\"membership\"></span></div>\n      </div>\n      <div class=\"nt-words\">\n        <span class=\"lab\">c-TF-IDF words</span><span data-source=\"topics\" data-field=\"keywords\"></span>\n        <span class=\"lab\">KeyBERT</span><span data-source=\"topics\" data-field=\"keybert\"></span>\n        <span class=\"lab\">MMR</span><span data-source=\"topics\" data-field=\"mmr\"></span>\n        <span class=\"lab\">Closest Raleigh topic</span><span><span data-source=\"topics\" data-field=\"raleigh_label\"></span> \u00b7 <span data-source=\"topics\" data-field=\"raleigh_share\"></span> of these reviews</span>\n      </div>\n      <div class=\"nt-starsbox\" data-source=\"topics\">\n        <div class=\"nt-stars\" role=\"img\" aria-label=\"Star rating mix\"></div>\n        <div class=\"nt-starkey\"></div>\n      </div>\n    </section>\n  </div>\n\n  <section class=\"nt-card\" id=\"reviews\">\n    <div class=\"nt-toolbar\">\n      <h2>Reviews in this topic</h2>\n      <div class=\"nt-seg\" role=\"group\" aria-label=\"Which reviews\">\n        <button type=\"button\" id=\"rv-typical\" aria-pressed=\"true\">Most typical</button>\n        <button type=\"button\" id=\"rv-random\" aria-pressed=\"false\">Random</button>\n      </div>\n    </div>\n    <p class=\"nt-note\">Most typical: the reviews HDBSCAN places most firmly in the topic. Random: an unweighted draw from the topic. Reviewer names are left out.</p>\n    <div class=\"nt-reviews\" data-source=\"reviews_sample\"></div>\n  </section>\n\n  <section class=\"nt-card\" id=\"topics\">\n    <div class=\"nt-toolbar\">\n      <h2>All topics</h2>\n      <input class=\"nt-search\" id=\"topic-search\" type=\"search\" placeholder=\"Search words, e.g. price, parking\" aria-label=\"Search topics\">\n    </div>\n    <p class=\"nt-note\">Topic numbers run from largest to smallest; \u22121 is reviews that fit no topic. Click a row to select it.</p>\n    <div class=\"nt-tablebox\">\n      <table class=\"nt-table\" data-source=\"topics\" data-row-key=\"topic\">\n        <thead><tr>\n          <th data-field=\"topic\" class=\"num\"><button type=\"button\" data-sort=\"topic\">Topic</button></th>\n          <th data-field=\"label\"><button type=\"button\" data-sort=\"label\">Top words</button></th>\n          <th data-field=\"reviews\" class=\"num\"><button type=\"button\" data-sort=\"reviews\">Reviews</button></th>\n          <th data-field=\"avg_stars\" class=\"num\"><button type=\"button\" data-sort=\"avg_stars\">Avg stars</button></th>\n          <th data-field=\"stores\" class=\"num\"><button type=\"button\" data-sort=\"stores\">Stores</button></th>\n          <th data-field=\"raleigh_label\"><button type=\"button\" data-sort=\"raleigh_label\">Closest Raleigh topic</button></th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <div class=\"nt-row\">\n    <section class=\"nt-card\" id=\"grid\">\n      <h2>Choosing the cluster size</h2>\n      <p class=\"nt-note\">HDBSCAN was run at several minimum cluster sizes. The highlighted row was chosen: it matches the Raleigh pilot's coherence with the best diversity and a topic count a person can still review by hand.</p>\n      <div class=\"nt-tablebox\">\n        <table class=\"nt-table nt-grid\" data-source=\"grid\" data-row-key=\"min_cluster_size\">\n          <thead><tr>\n            <th data-field=\"min_cluster_size\" class=\"num\">Min cluster size</th>\n            <th data-field=\"n_topics\" class=\"num\">Topics</th>\n            <th data-field=\"outlier_share\" class=\"num\">No topic</th>\n            <th data-field=\"coherence_cv\" class=\"num\">Coherence</th>\n            <th data-field=\"topic_diversity\" class=\"num\">Diversity</th>\n          </tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"nt-card\" id=\"method\">\n      <h2>How the topics were made</h2>\n      <ol class=\"nt-method\">\n        <li>Each review was cleaned as in the Raleigh pilot (lowercase, no punctuation, store names removed) and embedded with all-MiniLM-L12-v2.</li>\n        <li>UMAP reduced the embeddings to five dimensions for clustering, and to two for this map.</li>\n        <li>HDBSCAN found dense groups of reviews; reviews in no group are outliers.</li>\n        <li>BERTopic described each group with its most distinctive words (c-TF-IDF), plus KeyBERT and MMR word lists.</li>\n        <li>The closest Raleigh topic comes from Teresa's saved pilot model applied to the same reviews.</li>\n      </ol>\n      <p class=\"nt-note\">Source: NC master review database, freeze v2 counts. No labels were used at any step.</p>\n    </section>\n  </div>\n</div>\n\n<script>\n(() => {\n  const root = document.querySelector('.nt');\n  const fmtInt = d3.format(','), pct = d3.format('.1%'), pct0 = d3.format('.0%'), f3 = d3.format('.3f'), f2 = d3.format('.2f');\n  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });\n  const FMT = {\n    reviews_clustered: (v) => fmtInt(v), reviews_with_text: (v) => fmtInt(v), stores: (v) => fmtInt(v), topics: (v) => fmtInt(v),\n    teresa_topics: (v) => fmtInt(v), outlier_share: (v) => pct(v), coherence_cv: (v) => f3(v), topic_diversity: (v) => f3(v),\n    teresa_coherence: (v) => f3(v), teresa_diversity: (v) => f3(v),\n    topic: (v) => String(v), reviews: (v) => fmtInt(v), share: (v) => pct(v), avg_stars: (v) => f2(v), membership: (v) => f2(v),\n    raleigh_share: (v) => pct0(v),\n  };\n  const fmt = (field, v) => (v === null || v === undefined || v === '') ? '\u2014' : (FMT[field] ? FMT[field](Number(v)) : String(v));\n  const resolve = (c) => { const s = document.createElement('span'); s.style.color = c; root.appendChild(s); const v = getComputedStyle(s).color; s.remove(); return v; };\n  const withAlpha = (c, a) => { const x = d3.color(c); if (!x) return c; x.opacity = a; return x.formatRgb(); };\n\n  let reviewKind = 'typical', sortKey = 'reviews', sortDir = -1, query = '';\n  const selected = () => { const t = dash.params().topic; return t === undefined || t === null ? 0 : Number(t); };\n  const pick = (t) => dash.setParams({ topic: Number(t) });\n  if (dash.params().topic === undefined) dash.setParams({ topic: 0 });\n\n  const fail = (el) => { el.innerHTML = ''; const d = document.createElement('div'); d.className = 'nt-fail'; d.textContent = 'Failed to load'; el.appendChild(d); };\n  const done = (el) => el.classList.remove('dash-skeleton');\n\n  // ---------- summary ----------\n  function drawSummary() {\n    const S = dash.data('summary');\n    root.querySelectorAll('[data-source=\"summary\"]').forEach((el) => {\n      if (S.status === 'ok') { el.textContent = fmt(el.dataset.field, S.data[0][el.dataset.field]); done(el); }\n      else if (S.status === 'error') { el.textContent = '\u2014'; done(el); }\n      else { el.textContent = ''; el.classList.add('dash-skeleton'); }\n    });\n  }\n\n  // ---------- selected topic ----------\n  function topicRow(T) { const t = selected(); return T.data.find((r) => Number(r.topic) === t) || T.data.find((r) => Number(r.topic) === 0); }\n  function drawDetail(T) {\n    const box = root.querySelector('#topic');\n    const els = box.querySelectorAll('[data-source=\"topics\"][data-field]');\n    if (T.status !== 'ok') { els.forEach((el) => { el.textContent = '\u2014'; el.removeAttribute('data-where'); }); return; }\n    const r = topicRow(T);\n    els.forEach((el) => { el.setAttribute('data-where', 'topic=' + encodeURIComponent(r.topic)); el.textContent = fmt(el.dataset.field, r[el.dataset.field]); });\n    const ramp = d3.interpolateRgb(resolve('var(--cds-chart-muted)'), resolve(dash.colors[0]));\n    const stars = [1, 2, 3, 4, 5].map((k) => ({ k, v: Number(r['star' + k]) || 0, c: ramp((k - 1) / 4) }));\n    const bar = box.querySelector('.nt-stars'), key = box.querySelector('.nt-starkey');\n    bar.replaceChildren(...stars.map((s) => { const i = document.createElement('i'); i.style.width = (s.v * 100) + '%'; i.style.background = s.c; return i; }));\n    bar.setAttribute('aria-label', 'Star rating mix: ' + stars.map((s) => s.k + ' star ' + pct0(s.v)).join(', '));\n    key.replaceChildren(...stars.map((s) => { const sp = document.createElement('span'); const i = document.createElement('i'); i.style.background = s.c; sp.append(i, s.k + '\u2605 ' + pct0(s.v)); return sp; }));\n  }\n\n  // ---------- map ----------\n  const mapBox = root.querySelector('.nt-map'), canvas = mapBox.querySelector('canvas'), tip = mapBox.querySelector('.nt-tip');\n  let mapState = null;\n  function drawMap(M, T) {\n    if (M.status === 'error' || T.status === 'error') { fail(mapBox); return; }\n    if (M.status !== 'ok' || T.status !== 'ok') return;\n    if (!mapBox.contains(canvas)) mapBox.replaceChildren(canvas, tip);\n    const W = Math.max(280, mapBox.clientWidth), H = Math.round(Math.min(560, Math.max(320, W * 0.72))), dpr = Math.min(2, window.devicePixelRatio || 1);\n    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); canvas.style.height = H + 'px';\n    mapBox.style.minHeight = H + 'px';\n    const pts = M.data, sel = selected(), pad = 10;\n    const x = d3.scaleLinear(d3.extent(pts, (d) => Number(d.x)), [pad, W - pad]);\n    const y = d3.scaleLinear(d3.extent(pts, (d) => Number(d.y)), [H - pad, pad]);\n    const ctx = canvas.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);\n    const cSel = resolve(dash.colors[0]), cOth = withAlpha(resolve('var(--cds-chart-muted)'), 0.55), cOut = withAlpha(resolve('var(--cds-chart-muted)'), 0.22);\n    const dot = (d, r) => { ctx.moveTo(x(d.x) + r, y(d.y)); ctx.arc(x(d.x), y(d.y), r, 0, Math.PI * 2); };\n    ctx.beginPath(); ctx.fillStyle = cOut; for (const d of pts) if (Number(d.topic) === -1 && sel !== -1) dot(d, 1.1); ctx.fill();\n    ctx.beginPath(); ctx.fillStyle = cOth; for (const d of pts) if (Number(d.topic) !== -1 && Number(d.topic) !== sel) dot(d, 1.2); ctx.fill();\n    ctx.beginPath(); ctx.fillStyle = cSel; for (const d of pts) if (Number(d.topic) === sel) dot(d, 1.9); ctx.fill();\n    const r = topicRow(T);\n    if (r && Number(r.topic) !== -1) {\n      const lx = x(Number(r.cx)), ly = y(Number(r.cy));\n      ctx.font = '600 12px ' + getComputedStyle(root).fontFamily; ctx.textBaseline = 'middle';\n      const text = r.label, tw = ctx.measureText(text).width;\n      const tx = Math.min(Math.max(lx + 8, 4), W - tw - 8);\n      ctx.fillStyle = resolve('var(--color-panel)'); ctx.globalAlpha = 0.85; ctx.fillRect(tx - 4, ly - 9, tw + 8, 18); ctx.globalAlpha = 1;\n      ctx.fillStyle = resolve('var(--color-fg)'); ctx.fillText(text, tx, ly);\n    }\n    root.querySelector('.lg-sel').style.background = cSel; root.querySelector('.lg-oth').style.background = cOth; root.querySelector('.lg-out').style.background = cOut;\n    const labels = new Map(T.data.map((t) => [Number(t.topic), t.label]));\n    mapState = { qt: d3.quadtree(pts, (d) => x(d.x), (d) => y(d.y)), labels, W, H };\n  }\n  const nearest = (e) => { if (!mapState) return null; const b = canvas.getBoundingClientRect(); return { d: mapState.qt.find(e.clientX - b.left, e.clientY - b.top, 10), px: e.clientX - b.left, py: e.clientY - b.top }; };\n  canvas.addEventListener('pointermove', (e) => {\n    const n = nearest(e); if (!n || !n.d) { tip.hidden = true; return; }\n    const t = Number(n.d.topic);\n    tip.replaceChildren(); const k = document.createElement('div'); k.className = 'k'; k.textContent = t === -1 ? 'No topic' : 'Topic ' + t;\n    const v = document.createElement('div'); v.textContent = mapState.labels.get(t) || ''; tip.append(k, v); tip.hidden = false;\n    const tw = tip.offsetWidth, th = tip.offsetHeight;\n    tip.style.left = Math.min(n.px + 12, mapState.W - tw - 4) + 'px'; tip.style.top = Math.min(n.py + 12, mapState.H - th - 4) + 'px';\n  });\n  canvas.addEventListener('pointerleave', () => (tip.hidden = true));\n  canvas.addEventListener('click', (e) => { const n = nearest(e); if (n && n.d) pick(n.d.topic); });\n\n  // ---------- reviews ----------\n  const revBox = root.querySelector('.nt-reviews');\n  const stars = (n) => (n >= 1 && n <= 5) ? '\u2605'.repeat(n) + '\u2606'.repeat(5 - n) : 'no rating';\n  function drawReviews(R) {\n    if (R.status === 'error') { fail(revBox); return; }\n    if (R.status !== 'ok') { revBox.replaceChildren(); revBox.classList.add('dash-skeleton'); return; }\n    done(revBox);\n    const t = selected();\n    let rows = R.data.filter((r) => Number(r.topic) === t && (t === -1 || r.kind === reviewKind));\n    if (reviewKind === 'typical') rows.sort((a, b) => Number(b.membership) - Number(a.membership));\n    revBox.replaceChildren(...rows.map((r) => {\n      const el = document.createElement('article'); el.className = 'nt-rev';\n      const meta = document.createElement('div'); meta.className = 'meta';\n      const st = document.createElement('span'); st.className = 'st'; st.textContent = stars(Number(r.stars));\n      const where = document.createElement('span'); where.textContent = [r.store, r.city].filter(Boolean).join(' \u00b7 ');\n      const mem = document.createElement('span'); mem.textContent = 'membership ' + f2(Number(r.membership));\n      meta.append(st, where, mem);\n      const p = document.createElement('p'); p.textContent = r.text;\n      el.append(meta, p); return el;\n    }));\n    if (!rows.length) { const p = document.createElement('p'); p.className = 'nt-note'; p.textContent = 'No sample reviews for this topic.'; revBox.appendChild(p); }\n  }\n  const setKind = (k) => { reviewKind = k; root.querySelector('#rv-typical').setAttribute('aria-pressed', String(k === 'typical')); root.querySelector('#rv-random').setAttribute('aria-pressed', String(k === 'random')); drawReviews(dash.data('reviews_sample')); };\n  root.querySelector('#rv-typical').addEventListener('click', () => setKind('typical'));\n  root.querySelector('#rv-random').addEventListener('click', () => setKind('random'));\n\n  // ---------- topics table ----------\n  const tbody = root.querySelector('table[data-source=\"topics\"] tbody');\n  const NUMERIC = new Set(['topic', 'reviews', 'avg_stars', 'stores']);\n  function drawTable(T) {\n    if (T.status !== 'ok') { tbody.replaceChildren(); return; }\n    const max = d3.max(T.data.filter((r) => Number(r.topic) !== -1), (r) => Number(r.reviews)) || 1;\n    const q = query.trim().toLowerCase(), sel = selected(), accent = resolve(dash.colors[0]), muted = resolve('var(--cds-chart-muted)');\n    root.style.setProperty('--nt-accent', accent);\n    let rows = T.data.filter((r) => !q || [r.label, r.keywords, r.keybert, r.mmr, r.raleigh_label].join(' ').toLowerCase().includes(q));\n    rows = rows.slice().sort((a, b) => {\n      const av = a[sortKey], bv = b[sortKey];\n      const c = NUMERIC.has(sortKey) ? Number(av) - Number(bv) : String(av).localeCompare(String(bv));\n      return c * sortDir;\n    });\n    tbody.replaceChildren(...rows.map((r) => {\n      const tr = document.createElement('tr'); if (Number(r.topic) === sel) tr.className = 'on';\n      const td = (text, cls) => { const c = document.createElement('td'); if (cls) c.className = cls; c.textContent = text; return c; };\n      const n = document.createElement('td'); n.className = 'num';\n      const wrap = document.createElement('div'); wrap.className = 'nt-bar';\n      const bar = document.createElement('i'); bar.style.width = (Number(r.topic) === -1 ? 0 : Number(r.reviews) / max * 6) + 'rem'; bar.style.background = Number(r.topic) === sel ? accent : muted;\n      const lab = document.createElement('span'); lab.textContent = fmtInt(Number(r.reviews));\n      wrap.append(bar, lab); n.appendChild(wrap);\n      tr.append(td(String(r.topic), 'num'), td(r.label, 'nt-label'), n, td(f2(Number(r.avg_stars)), 'num'), td(fmtInt(Number(r.stores)), 'num'), td(r.raleigh_label, 'nt-label'));\n      tr.addEventListener('click', () => pick(r.topic));\n      return tr;\n    }));\n    root.querySelectorAll('table[data-source=\"topics\"] th').forEach((th) => th.setAttribute('aria-sort', th.dataset.field === sortKey ? (sortDir > 0 ? 'ascending' : 'descending') : 'none'));\n  }\n  root.querySelectorAll('table[data-source=\"topics\"] th button').forEach((b) => b.addEventListener('click', () => {\n    const k = b.dataset.sort; if (k === sortKey) sortDir = -sortDir; else { sortKey = k; sortDir = (k === 'label' || k === 'raleigh_label' || k === 'topic') ? 1 : -1; }\n    drawTable(dash.data('topics'));\n  }));\n  root.querySelector('#topic-search').addEventListener('input', (e) => { query = e.target.value; drawTable(dash.data('topics')); });\n\n  // ---------- grid ----------\n  const gbody = root.querySelector('table.nt-grid tbody');\n  function drawGrid(G) {\n    if (G.status !== 'ok') { gbody.replaceChildren(); return; }\n    gbody.replaceChildren(...G.data.map((r) => {\n      const tr = document.createElement('tr');\n      const td = (text, cls) => { const c = document.createElement('td'); if (cls) c.className = cls; c.textContent = text; return c; };\n      if (r.chosen === true || r.chosen === 'true') tr.className = 'on';\n      tr.append(td(String(r.min_cluster_size), 'num'), td(fmtInt(Number(r.n_topics)), 'num'), td(pct(Number(r.outlier_share)), 'num'), td(f3(Number(r.coherence_cv)), 'num'), td(f3(Number(r.topic_diversity)), 'num'));\n      return tr;\n    }));\n  }\n\n  dash.onData(() => {\n    const T = dash.data('topics');\n    drawSummary();\n    drawDetail(T);\n    drawMap(dash.data('map_points'), T);\n    drawReviews(dash.data('reviews_sample'));\n    drawTable(T);\n    drawGrid(dash.data('grid'));\n  });\n\n  const named = document.getElementById(location.hash.slice(1));\n  if (named) requestAnimationFrame(() => { named.scrollIntoView(); dash.setLink(named.id); });\n})();\n</script>\n"}